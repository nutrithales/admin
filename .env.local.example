# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — server-only, NEVER expose to the client.
# Used to create/ban/delete Supabase Auth users when managing pacientes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Resend — envia a senha de acesso ao paciente por e-mail ao cadastrar
# ou resetar senha. Sem isso configurado, a senha só aparece na tela.
RESEND_API_KEY=
EMAIL_FROM="Nutri Thales Rosa <naoresponda@nutrithales.com.br>"

# Opcional: link do portal do paciente, incluído no e-mail de senha.
NEXT_PUBLIC_PATIENT_LOGIN_URL=

# Google Gemini — usado pelo construtor de planos (rascunho por IA, ajuste
# de receitas, importação de plano existente) e pela interpretação do PDF
# do Bodymetrix e busca de alimento por IA. Sem isso configurado, esses
# botões ficam desabilitados; o resto do painel funciona normalmente.
# Gere uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Agenda pública — integração server-side com o projeto nutri-site.
# Use a mesma senha definida como ADMIN_PASSWORD no projeto da agenda.
AGENDA_API_URL=https://www.nutrithales.com.br
AGENDA_ADMIN_PASSWORD=

# Segredo compartilhado entre o nutri-site e este painel para registrar
# automaticamente cada novo agendamento no perfil do paciente.
AGENDA_SYNC_SECRET=

# Formulários / Check-ins — URL pública usada nos links individuais.
NEXT_PUBLIC_FORM_BASE_URL=https://admin.nutrithales.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.nutrithales.com.br

# Seu GPT de check-ins no ChatGPT. O painel copia o prompt clínico e abre este endereço.
NEXT_PUBLIC_CHATGPT_CHECKIN_URL=https://chatgpt.com/g/g-6a7cafe17184819196aad68445c4c67c-assistentente-check-in-thales-rosa

# WhatsApp Business Platform / Cloud API — somente server-side.
# Use um System User access token; nunca exponha o token no NEXT_PUBLIC_*.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_FORMULARIO=
WHATSAPP_GRAPH_VERSION=v23.0

# Protege /api/cron/formularios. O agendador envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
